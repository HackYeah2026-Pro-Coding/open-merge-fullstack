# Copy to .env:  cp .env.example .env
# One .env at the repo root serves the API, Prisma and Vite.

# ─── Which database? ─────────────────────────────────────────────────────────
# local    -> the Postgres container from docker-compose.yml
# supabase -> the hosted Supabase project
# Switch with `pnpm use:local` / `pnpm use:supabase`, or edit this line.
DB_TARGET=local

# ─── Local (docker-compose) ──────────────────────────────────────────────────
LOCAL_DATABASE_URL="postgresql://escrow:escrow@localhost:55432/escrow?schema=public"

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard -> Connect -> choose "Session pooler" (NOT "Direct connection":
# direct is IPv6-only unless you pay for the IPv4 add-on, and will simply time
# out on most networks). Session pooler is IPv4 on every plan, supports prepared
# statements, and works for both the app and `prisma migrate`.
#
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# If you hit "self-signed certificate in certificate chain", swap
# sslmode=require for sslmode=no-verify — this driver treats `require` as full
# certificate verification.
SUPABASE_DATABASE_URL=""

# Only needed if SUPABASE_DATABASE_URL points at the TRANSACTION pooler (port
# 6543), which cannot run migrations. Put a session-pooler (5432) URL here and
# the Prisma CLI will use it for migrate/studio while the app keeps the pooled
# one. Leave empty when using the session pooler above.
#
# It is the same URL with the port changed to 5432 and any pgbouncer=true removed:
#
#   SUPABASE_DATABASE_URL  ...@aws-<n>-<region>.pooler.supabase.com:6543/postgres
#   SUPABASE_DIRECT_URL    ...@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# Without it, `pnpm db:migrate` against the transaction pooler hangs instead of failing.
SUPABASE_DIRECT_URL=""

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
WEB_ORIGIN="http://localhost:5173"
# Public base URL of this API (no trailing slash). Used to build absolute links
# such as the token image URL, so in production it must be reachable from outside.
API_URL="http://localhost:3000"
# Signs wallet-link challenges (min 32 chars). Required in production, e.g. `openssl rand -hex 32`.
WALLET_CHALLENGE_SECRET=""
# Signs session cookies (min 32 chars). Required in production, e.g. `openssl rand -hex 32`.
SESSION_SECRET=""

# ─── GitHub sign-in ──────────────────────────────────────────────────────────
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App, with
#   Authorization callback URL: http://localhost:5173/api/auth/github/callback
# That is the web app's origin, not :3000: the callback goes through Vite's /api
# proxy, which keeps the session cookie first-party. Production needs its own
# OAuth App with https://<web-domain>/api/auth/github/callback.
# Without these the API still boots in development and sign-in answers 503.
# Real sign-in also needs VITE_API_MODE=http. Keep the secret in .env only.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Web (Vite) ──────────────────────────────────────────────────────────────
# mock -> the web app runs on an in-browser mock of the API (no backend needed)
# http -> the web app calls the NestJS API under /api
VITE_API_MODE=mock
# Repository the mock pretends to manage. The real API reports its own.
VITE_GITHUB_REPO="HackYeah2026-Pro-Coding/open-merge-fullstack"
# Cluster used for Solana explorer links: devnet | testnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet
