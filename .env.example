# Copy to .env:  cp .env.example .env
# One .env at the repo root serves the API, Prisma and Vite.

# ─── Which database? ─────────────────────────────────────────────────────────
# local    -> the Postgres container from docker-compose.yml
# supabase -> the hosted Supabase project
# Switch with `pnpm use:local` / `pnpm use:supabase`, or edit this line.
DB_TARGET=local

# ─── Local (docker-compose) ──────────────────────────────────────────────────
LOCAL_DATABASE_URL="postgresql://escrow:escrow@localhost:55432/escrow?schema=public"

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard -> Connect -> choose "Session pooler" (NOT "Direct connection":
# direct is IPv6-only unless you pay for the IPv4 add-on, and will simply time
# out on most networks). Session pooler is IPv4 on every plan, supports prepared
# statements, and works for both the app and `prisma migrate`.
#
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# If you hit "self-signed certificate in certificate chain", swap
# sslmode=require for sslmode=no-verify — this driver treats `require` as full
# certificate verification.
SUPABASE_DATABASE_URL=""

# Only needed if SUPABASE_DATABASE_URL points at the TRANSACTION pooler (port
# 6543), which cannot run migrations. Put a session-pooler (5432) URL here and
# the Prisma CLI will use it for migrate/studio while the app keeps the pooled
# one. Leave empty when using the session pooler above.
#
# It is the same URL with the port changed to 5432 and any pgbouncer=true removed:
#
#   SUPABASE_DATABASE_URL  ...@aws-<n>-<region>.pooler.supabase.com:6543/postgres
#   SUPABASE_DIRECT_URL    ...@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# Without it, `pnpm db:migrate` against the transaction pooler hangs instead of failing.
SUPABASE_DIRECT_URL=""

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
WEB_ORIGIN="http://localhost:5173"
# Public base URL of this API (no trailing slash). Used to build absolute links
# such as the token image URL, so in production it must be reachable from outside.
API_URL="http://localhost:3000"
# Signs wallet-link challenges (min 32 chars). Required in production, e.g. `openssl rand -hex 32`.
WALLET_CHALLENGE_SECRET=""
# Signs session cookies (min 32 chars). Required in production, e.g. `openssl rand -hex 32`.
SESSION_SECRET=""

# ─── GitHub sign-in ──────────────────────────────────────────────────────────
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App, with
#   Authorization callback URL: http://localhost:5173/api/auth/github/callback
# That is the web app's origin, not :3000: the callback goes through Vite's /api
# proxy, which keeps the session cookie first-party. Production needs its own
# OAuth App with https://<web-domain>/api/auth/github/callback.
# Without these the API still boots in development and sign-in answers 503.
# Real sign-in also needs VITE_API_MODE=http. Keep the secret in .env only.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Organization ────────────────────────────────────────────────────────────
# Repositories under this GitHub organization are the ones that carry bounties.
GITHUB_ORG="HackYeah2026-Pro-Coding"
# GitHub login shown as the organization's owner, who posts bounties.
# Required in production; development falls back to GITHUB_ORG.
GITHUB_OWNER_LOGIN=""

# ─── Web (Vite) ──────────────────────────────────────────────────────────────
# mock -> the web app runs on an in-browser mock of the API (no backend needed)
# http -> the web app calls the NestJS API under /api
VITE_API_MODE=mock
# GitHub organization the mock serves. The real API reports its own.
VITE_GITHUB_ORG="HackYeah2026-Pro-Coding"
# Cluster used for Solana explorer links: devnet | testnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet
# Mint of the reward token (OMT) shown on the /token page. Must be on the cluster above.
VITE_TOKEN_MINT="9tBiUuzd6E3JAwKcdPW26CicHYvcPKvazVvRJjEZPQa9"

# ─── Solana ──────────────────────────────────────────────────────────────────
# POST /api/issue locks each reward in a new escrow on chain. Escrow is off until
# SERVER_WALLET_KEYPAIR_B64 is set (the API boots, POST /api/issue answers 503);
# once it is, every variable below is required and checked at boot.
#
# RPC endpoint the API talks to; keep it on the same cluster as above. The public
# devnet URL rate-limits hard (429); a free Helius/QuickNode devnet URL or
# https://solana-devnet.api.onfinality.io/public works better.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Address of the deployed escrow program. Must match src/solana/idl in the API.
ESCROW_PROGRAM_ID=9MN1vjVWQpePTmrY7nzMBu5ZeGDtQtCbQvWamJWTDMV3
# Mint of the token bounties are paid in (OMT, Token-2022).
TOKEN_MINT=9tBiUuzd6E3JAwKcdPW26CicHYvcPKvazVvRJjEZPQa9
# Keypairs are solana-keygen JSON files, base64-encoded on one line:
#   base64 -i path/to/keypair.json | tr -d '\n'
#
# Verifier keypair: the only signer allowed to release or cancel an escrow. Its
# public key is stored in every escrow at creation. Secret, never commit it.
SOLANA_CI_KEYPAIR_B64=
# Server wallet keypair: the `client` that funds every escrow, so it must hold
# TOKEN_MINT tokens and some SOL (~0.004 per escrow). Keep it a different wallet
# from the verifier. Secret, never commit it.
SERVER_WALLET_KEYPAIR_B64=
# Public address of the server wallet. Must match SERVER_WALLET_KEYPAIR_B64; it is
# checked at boot to catch a pasted wrong file.
SERVER_WALLET_ADDRESS=

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Shared secret of the repo webhook (Settings -> Webhooks -> Secret). GitHub signs
# each delivery with it in X-Hub-Signature-256. Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=XXX
# Token for GitHub REST API calls: looking up a repo in POST /api/repo and opening
# the matching GitHub issue in POST /api/issue.
# Without it, repo lookups are anonymous (public repos only, 60/hour) and
# POST /api/issue is refused. Create a fine-grained token at Settings -> Developer
# settings -> Personal access tokens with access to the repos you add, and
# permissions "Metadata: Read-only" and "Issues: Read and write".
GITHUB_TOKEN=""

# ─── AI review of pull requests ──────────────────────────────────────────────
# Webhook target: POST <API_URL>/api/review/webhook, event "Pull requests" only.
# GITHUB_WEBHOOK_SECRET above signs it. GITHUB_TOKEN must belong to the bot account
# and allow: Metadata, Contents, Actions (read); Issues, Pull requests, Commit
# statuses (read and write).
# Local: gh webhook forward --org=<org> --events=pull_request \
#          --url=http://localhost:3000/api/review/webhook --secret=$GITHUB_WEBHOOK_SECRET
ANTHROPIC_API_KEY=""
# Model used for the Claude half of the review.
CLAUDE_REVIEW_MODEL="claude-opus-5-5"
GEMINI_API_KEY=""
# Pick the current Gemini Pro model name in Google AI Studio.
GEMINI_MODEL=""
