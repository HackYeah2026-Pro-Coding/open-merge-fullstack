// Minimal starting schema.
//
// Prisma 7 specifics worth knowing before you edit this file:
//   * the client is generated into ../src/generated/prisma (gitignored, NOT node_modules)
//   * moduleFormat/importFileExtension make the output compile with NestJS' CommonJS tsc build
//   * the datasource URL lives in prisma.config.ts, not here
//   * enums must be written across multiple lines — `enum X { A B }` is a syntax error

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A developer's GitHub account. The wallet is optional until they link one.
model GithubAccount {
  id          String  @id @default(cuid())
  githubId    Int     @unique
  githubLogin String  @unique
  name        String?
  avatarUrl   String?
  walletId    String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  wallet     Wallet?  @relation(fields: [walletId], references: [id])
  paidIssues Issue[]
  payouts    Payout[]
}

model Wallet {
  id       String   @id @default(cuid())
  /// Base58 Solana public key.
  address  String   @unique
  linkedAt DateTime @default(now()) @db.Timestamptz(3)

  account GithubAccount?
}

model GithubRepo {
  id             String @id @default(cuid())
  /// "owner/name", as GitHub shows it.
  githubRepoName String @unique
  githubRepoUrl  String
  /// Copied from GitHub when the repo is added or updated.
  description    String?
  isPrivate      Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  issues       Issue[]
  pullRequests PullRequest[]
}

/// PENDING until the escrow account is verified on chain, then FUNDED, and
/// RELEASED once the reward is paid out to the developer.
enum EscrowStatus {
  PENDING
  FUNDED
  RELEASED
}

model Issue {
  id                String   @id @default(cuid())
  title             String
  body              String
  labels            String[] @default([])
  /// Integer base units of the reward token, never a float.
  rewardAmount      BigInt
  rewardSymbol      String
  githubRepoId      String
  /// Set once the matching issue is opened on GitHub, so null until then.
  githubIssueNumber Int?
  githubIssueUrl    String?
  /// Base58 address of the on-chain escrow account; the vault is derived from it.
  escrowAddress     String?      @unique
  /// Signature of the create_and_deposit transaction that funded the escrow.
  escrowSignature   String?      @unique
  escrowStatus      EscrowStatus @default(PENDING)
  paidOutToId       String?

  paidOutAt DateTime? @db.Timestamptz(3)
  closedAt  DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  githubRepo   GithubRepo     @relation(fields: [githubRepoId], references: [id])
  paidOutTo    GithubAccount? @relation(fields: [paidOutToId], references: [id])
  payout       Payout?
  pullRequests PullRequest[]

  @@unique([githubRepoId, githubIssueNumber])
  @@index([githubRepoId])
  @@index([paidOutToId])
}

model Payout {
  id                String  @id @default(cuid())
  issueId           String  @unique
  recipientGithubId Int
  walletAddress     String?
  /// Signature of the release transaction; null until the reward is paid out.
  releaseSignature  String? @unique

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)

  issue     Issue         @relation(fields: [issueId], references: [id])
  recipient GithubAccount @relation(fields: [recipientGithubId], references: [githubId])

  @@index([recipientGithubId])
}

enum PullRequestState {
  open
  merged
  closed
}

/// A pull request that references a bounty issue. Kept in sync from the review webhook.
model PullRequest {
  id              String           @id @default(cuid())
  githubRepoId    String
  issueId         String
  number          Int
  title           String
  url             String
  authorLogin     String
  authorAvatarUrl String?
  state           PullRequestState @default(open)
  headSha         String

  openedAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  githubRepo GithubRepo @relation(fields: [githubRepoId], references: [id])
  issue      Issue      @relation(fields: [issueId], references: [id])
  reviews    Review[]

  @@unique([githubRepoId, number])
  @@index([issueId])
}

enum ReviewStatus {
  pending
  completed
  failed
}

enum CiState {
  passed
  failed
  none
  timeout
}

/// One review run of one head commit. The unique key makes a redelivered webhook a no-op.
model Review {
  id            String       @id @default(cuid())
  pullRequestId String
  headSha       String
  status        ReviewStatus @default(pending)
  ciState       CiState?
  /// Names of the CI jobs that failed, shown to the maintainer.
  failedJobs    String[]     @default([])
  /// Files left out of the model context, with the reason.
  contextNotes  String[]     @default([])
  /// Why the run as a whole failed; null otherwise.
  error         String?

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  pullRequest PullRequest      @relation(fields: [pullRequestId], references: [id])
  results     ReviewerResult[]

  @@unique([pullRequestId, headSha])
}

enum ReviewVerdict {
  approve
  changes
}

/// What one model said about one review run.
model ReviewerResult {
  id           String         @id @default(cuid())
  reviewId     String
  /// "claude" or "gemini".
  reviewer     String
  model        String?
  verdict      ReviewVerdict?
  /// The validated structured answer; null when this reviewer failed.
  output       Json?
  error        String?
  inputTokens  Int?
  outputTokens Int?
  /// Tool calls the reviewer made, as ReviewSource[]; null when it failed or ran before tools existed.
  sources      Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id])

  @@unique([reviewId, reviewer])
}
