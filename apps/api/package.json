{
  "name": "@escrow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "demo": "tsx scripts/demo/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@anchor-lang/core": "1.2.0",
    "@escrow/shared": "workspace:*",
    "@google/genai": "2.27.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.2",
    "@nestjs/testing": "12.1.2",
    "@types/bn.js": "5.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "dotenv": "17.4.2",
    "jest": "30.5.2",
    "prisma": "7.9.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "api",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
          "^.+\\.ts$": "ts-jest"
        },
        "testEnvironment": "node"
      },
      {
        "displayName": "demo",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": "scripts",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "<rootDir>/tsconfig.json"
            }
          ]
        },
        "testEnvironment": "node"
      }
    ]
  }
}
